<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>Tessera</Product>
    <AssemblyTitle>Tessera</AssemblyTitle>
    <Description>Tessera — pixel art and icon studio</Description>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PixelArtDownscale\PixelArtDownscale.csproj" />
    <ProjectReference Include="..\PixelArtAlignment\PixelArtAlignment.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app-icon.png" />
    <Resource Include="Assets\landscape.png" />
  </ItemGroup>
</Project>
