<UserControl x:Class="DomainColorTest.IconWorkspace"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:DomainColorTest" Background="#101010" Foreground="#EEEEEE">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries>
            <DrawingBrush x:Key="IconChecker" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
                <DrawingBrush.Drawing><DrawingGroup>
                    <GeometryDrawing Brush="#151515" Geometry="M0,0 H16 V16 H0 Z"/>
                    <GeometryDrawing Brush="#242424" Geometry="M0,0 H8 V8 H0 Z M8,8 H16 V16 H8 Z"/>
                </DrawingGroup></DrawingBrush.Drawing>
            </DrawingBrush>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer x:Name="iconScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="iconContent" Margin="32,16,32,32">
            <DockPanel Margin="0,0,0,24">
                <Button x:Name="iconBackButton" Content="←" Width="34" Height="32" Margin="0,0,14,0" DockPanel.Dock="Left" ToolTip="На главную" AutomationProperties.Name="На главную"/>
                <TextBlock Text="Создание иконок" FontSize="25" FontWeight="SemiBold"/>
            </DockPanel>
            <Border x:Name="iconDropPanel" BorderBrush="#3A3A3A" BorderThickness="1" Background="#151515" Padding="24">
                <Grid x:Name="iconSetupGrid">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel x:Name="iconImagePanel" Margin="0,0,28,0">
                        <Border Height="156" Background="{StaticResource IconChecker}">
                            <Grid>
                                <Image x:Name="iconSourceImage" Margin="12" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                <TextBlock x:Name="iconEmptyHint" Text="Перетащите&#x0a;изображение" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="14"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="iconFileLabel" TextTrimming="CharacterEllipsis" Margin="0,10,0,0" Foreground="#AAAAAA"/>
                    </StackPanel>
                    <StackPanel x:Name="iconControls" Grid.Column="1">
                        <WrapPanel Margin="0,0,0,18">
                            <Button x:Name="iconOpenButton" Content="Открыть изображение…" Padding="18,11" Margin="0,0,12,8"/>
                            <Button x:Name="iconSaveButton" Content="Сохранить ICO…" Style="{StaticResource PrimaryButton}" Padding="18,11" Margin="0,0,0,8" IsEnabled="False"/>
                        </WrapPanel>
                        <WrapPanel x:Name="iconEditorChoices" Visibility="Collapsed" Margin="0,0,0,12">
                            <Button x:Name="iconUseSourceButton" Content="Исходник из редактора" Margin="0,0,10,8"/>
                            <Button x:Name="iconUseResultButton" Content="Результат из редактора" Margin="0,0,0,8"/>
                        </WrapPanel>
                        <WrapPanel x:Name="iconSizes" Margin="0,0,0,4"/>
                        <WrapPanel Margin="0,0,0,18">
                            <CheckBox x:Name="iconCustomCheck" Content="Свой размер, px" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <local:IntegerInput x:Name="iconCustomSize" Minimum="1" Maximum="256" Value="96" Width="92" IsEnabled="False" AutomationProperties.Name="Сторона иконки в пикселях"/>
                        </WrapPanel>
                        <WrapPanel>
                            <StackPanel Margin="0,0,16,8">
                                <TextBlock Text="Масштабирование" Margin="0,0,0,6"/>
                                <ComboBox x:Name="iconResizeMode" Width="180" SelectedIndex="0">
                                    <ComboBoxItem Content="Пиксельное"/><ComboBoxItem Content="Плавное"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="Пропорции" Margin="0,0,0,6"/>
                                <ComboBox x:Name="iconFitMode" Width="180" SelectedIndex="0">
                                    <ComboBoxItem Content="Вписать в квадрат"/><ComboBoxItem Content="Обрезать по центру"/><ComboBoxItem Content="Растянуть"/>
                                </ComboBox>
                            </StackPanel>
                        </WrapPanel>
                        <StackPanel Margin="0,10,0,0">
                            <CheckBox x:Name="iconRemoveBackground" Content="Удалить фон" ToolTip="Удаляет однотонный цвет, включая замкнутые участки внутри изображения. Исходник не изменяется."/>
                            <WrapPanel x:Name="iconBackgroundSettings" Visibility="Collapsed" Margin="0,8,0,0">
                                <StackPanel Margin="0,0,16,8">
                                    <TextBlock Text="Цвет фона" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="iconBackgroundColor" Width="180" SelectedIndex="0">
                                        <ComboBoxItem Content="Авто по краям"/><ComboBoxItem Content="Белый"/><ComboBoxItem Content="Чёрный"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,8" Width="180">
                                    <DockPanel Margin="0,0,0,6"><TextBlock Text="Допуск"/><TextBlock Text="{Binding Value, ElementName=iconBackgroundTolerance, StringFormat={}{0}%}" HorizontalAlignment="Right"/></DockPanel>
                                    <Slider x:Name="iconBackgroundTolerance" Minimum="0" Maximum="100" Value="8" TickFrequency="1" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft" AutomationProperties.Name="Допуск удаления фона" ToolTip="0 — точное совпадение цвета. Чем выше допуск, тем больше похожих оттенков станет прозрачным."/>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>

                    </StackPanel>
                </Grid>
            </Border>
            <TextBlock x:Name="iconPreviewHint" Text="Выберите размеры — они будут сохранены в одном ICO." Foreground="#AAAAAA" Margin="0,22,0,8" TextWrapping="Wrap"/>
            <ItemsControl x:Name="iconFrames" Margin="0,24,0,0">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel VerticalAlignment="Bottom"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate>
                    <StackPanel Margin="0,0,24,24" VerticalAlignment="Bottom">
                        <Grid Height="256" MinWidth="40">
                            <Border Width="{Binding Size}" Height="{Binding Size}" VerticalAlignment="Bottom" Background="{StaticResource IconChecker}">
                                <Image Source="{Binding Image}" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" Foreground="#AAAAAA" Margin="0,12,0,0" FontFamily="Consolas"/>
                    </StackPanel>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
